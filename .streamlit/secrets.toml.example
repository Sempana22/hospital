# Salin file ini menjadi secrets.toml lalu isi dengan nilai Anda sendiri.
# JANGAN commit secrets.toml (asli) ke Git.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "your-anon-public-key"
# Jangan gunakan key ini untuk client publik atau commit ke Git.
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "STIKESKARYAHUSADA"
